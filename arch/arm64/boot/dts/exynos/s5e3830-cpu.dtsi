			};

			domain@1 {
				cpus = "4-7";
				table = <0xc4c70 0x9c4 0x1a94b0 0x9c4>;
			};
		};

		emstune {
			boost-level = <0x02>;
			boot-set = <0x5b>;

			mode0 {
