		compatible = "samsung,ems";
		status = "okay";

		pe-list {

			list@0 {
				cpus = "0-7";
			};
		};

		cpu-selection-domain {

			ananke0 {
				cpus = "0-3";
			};

			ananke1 {
				cpus = "4-7";
			};
		};

		halo {

			domain@0 {
				cpus = "0-3";
				expired-ratio = <0x64>;
			};

			domain@1 {
				cpus = "4-7";
				expired-ratio = <0x64>;
			};
		};

		ego {
			thread-run-on = "0-3";

			domain@0 {
				cpus = "0-3";
				ratio = <0x3e8>;
			};

			domain@1 {
				cpus = "4-7";
				ratio = <0x3e8>;
			};
		};

		ecs {
			default-gov = <0x00>;

			domain0 {
				cpus = "0-3";

				stage0 {
					cpus = "0-1";
				};

				stage1 {
					cpus = "0-3";
				};
			};

			domain1 {
				cpus = "4-7";

				stage0 {
					cpus = "4-5";
					busy-threshold = <0x00>;
				};

				stage1 {
					cpus = "4-7";
				};
			};
		};

		ecs_dynamic {
			default-gov = <0x01>;

			domain0 {
				cpus = "0-3";
				default-cpus = "0-3";
			};

			domain1 {
				cpus = "4-7";
				default-cpus = "4-5";
			};
		};

		freq-variant {

			domain@0 {
				cpus = "0-3";
