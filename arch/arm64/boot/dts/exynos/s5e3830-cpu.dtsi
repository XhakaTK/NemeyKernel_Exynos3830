/* Samsung Exynos 850 (S5E3830) - CPU topology, power management and performance sets */

	arm-pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x59 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04 0x00 0x5c 0x04 0x00 0x6c 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04>;
		interrupt-affinity = <0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55>;
	};

	power-data {

		cpu {

			ananke-power-data0 {
				cpus = "0-3";
				capacity-dmips-mhz = <0x10f>;
				dynamic-power-coefficient = <0x7d>;
				static-power-coefficient = <0x0a>;
				dhry-to-clang-dp-ratio = <0x334>;
				dhry-to-clang-cap-ratio = <0x174>;
			};

			ananke-power-data1 {
				cpus = "4-7";
				capacity-dmips-mhz = <0x10f>;
				dynamic-power-coefficient = <0x7d>;
				static-power-coefficient = <0x0a>;
				dhry-to-clang-dp-ratio = <0x334>;
				dhry-to-clang-cap-ratio = <0x174>;
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x4e>;
				};

				core1 {
					cpu = <0x4f>;
				};

				core2 {
					cpu = <0x50>;
				};

				core3 {
					cpu = <0x51>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x52>;
				};

				core1 {
					cpu = <0x53>;
				};

				core2 {
					cpu = <0x54>;
				};

				core3 {
					cpu = <0x55>;
				};
			};
		};

		cpu@0000 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x4e>;
		};

		cpu@0001 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x4f>;
		};

		cpu@0002 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x50>;
		};

		cpu@0003 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x51>;
		};

		cpu@0004 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x52>;
		};

		cpu@0005 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x53>;
		};

		cpu@0006 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x10200>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x54>;
		};

		cpu@0007 {
			device_type = "cpu";
			compatible = "arm,ananke\0arm,armv8";
			reg = <0x00 0x10300>;
			enable-method = "psci";
			cpu-idle-states = <0x56>;
			phandle = <0x55>;
		};
	};

	idle-states {
		entry-method = "arm,psci";

		ananke-cpu-sleep {
			idle-state-name = "c2";
			compatible = "arm,idle-state";
			arm,psci-suspend-param = <0x10000>;
			entry-latency-us = <0x46>;
			exit-latency-us = <0xa0>;
			min-residency-us = <0x7d0>;
			status = "okay";
			phandle = <0x56>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	freq-qos-tracer {
		compatible = "samsung,freq-qos-tracer";
		status = "okay";
	};

	exynos-acme {
		compatible = "samsung,exynos-acme";
		status = "okay";

		domain@0 {
			sibling-cpus = "0-3";
			cal-id = <0xb040002>;
			dm-type = <0x00>;
			min-freq = <0x854d0>;
			thread-run-on = "0-3";
			#cooling-cells = <0x02>;
			ect-coeff-index = <0x01>;
			tz-cooling-name = "LITTLE0";
			freq-table = <0x6be90 0x854d0 0x9eb10 0xc4c70 0xe7b08 0x101148 0x11a788 0x13d620 0x163780 0x183350 0x1a94b0 0x1c2af0 0x1e8c50 0x21b8d0>;
			phandle = <0x9b>;

			dm-constraints {
				list = <0x57 0x58>;
			};

			slack_timer {
				device_type = "slack-timer-domain";
			};
		};

		domain@1 {
			sibling-cpus = "4-7";
			cal-id = <0xb040003>;
			dm-type = <0x01>;
			min-freq = <0x854d0>;
			need-awake;
			thread-run-on = "0-3";
			#cooling-cells = <0x02>;
			ect-coeff-index = <0x00>;
			tz-cooling-name = "LITTLE1";
			freq-table = <0x6be90 0x854d0 0x9eb10 0xc4c70 0xe7b08 0x101148 0x11a788 0x13d620 0x163780 0x183350 0x1a94b0 0x1c2af0 0x1e8c50 0x21b8d0>;
			phandle = <0xa5>;

			dm-constraints {
				list = <0x59 0x5a>;
			};

			slack_timer {
				device_type = "slack-timer-domain";
				expired_time = <0x50>;
			};
		};
	};

	dm-tables {

		dm-table@0000 {
			const-type = <0x00>;
			dm-slave = <0x02>;
			master-cal-id = <0xb040002>;
			slave-cal-id = <0xb040000>;
			dynamic-disable;
			phandle = <0x57>;

			normal {
				table = <0x6be90 0xa50a0 0x854d0 0xa50a0 0x9eb10 0xa50a0 0xc4c70 0xa50a0 0xe7b08 0xa50a0 0x101148 0xce4c8 0x11a788 0xce4c8 0x13d620 0xf78f0 0x163780 0xf78f0 0x183350 0x14a140 0x1a94b0 0x14a140 0x1c2af0 0x177bb8 0x1e8c50 0x177bb8 0x21b8d0 0x177bb8>;
			};
		};

		dm-table@0001 {
			const-type = <0x00>;
			dm-slave = <0x02>;
			master-cal-id = <0xb040003>;
			slave-cal-id = <0xb040000>;
			dynamic-disable;
			phandle = <0x59>;

			normal {
				table = <0x6be90 0xa50a0 0x854d0 0xa50a0 0x9eb10 0xa50a0 0xc4c70 0xa50a0 0xe7b08 0xa50a0 0x101148 0xce4c8 0x11a788 0xce4c8 0x13d620 0xf78f0 0x163780 0xf78f0 0x183350 0x14a140 0x1a94b0 0x14a140 0x1c2af0 0x177bb8 0x1e8c50 0x177bb8 0x21b8d0 0x177bb8>;
			};
		};

		dm-table@0002 {
			guidance;
			const-type = <0x00>;
			dm-slave = <0x02>;
			master-cal-id = <0xb040002>;
			slave-cal-id = <0xb040000>;
			phandle = <0x58>;

			skew {
				ect-name = "dvfs_cpucl0";
			};
		};

		dm-table@0003 {
			guidance;
			const-type = <0x00>;
			dm-slave = <0x02>;
			master-cal-id = <0xb040003>;
			slave-cal-id = <0xb040000>;
			phandle = <0x5a>;

			skew {
				ect-name = "dvfs_cpucl1";
			};
		};
	};

	exynos-cpupm {
		compatible = "samsung,exynos-cpupm";
		status = "okay";

		cpd_cl0 {
			device_type = "cpupm";
			target-residency = <0x2710>;
			type = <0x00>;
			cal-id = <0x00>;
			siblings = "0-3";
		};

		cpd_cl1 {
			device_type = "cpupm";
			target-residency = <0x2710>;
			type = <0x00>;
			cal-id = <0x01>;
			siblings = "4-7";
			entry-allowed = "4-7";
		};

		sicd {
			device_type = "cpupm";
			target-residency = <0x2710>;
			type = <0x02>;
			siblings = "0-7";
			entry-allowed = "0-7";
		};

		wakeup-mask {

			wakeup-masks {

				wakeup-mask {
					mask-reg-offset = <0x3944>;
					stat-reg-offset = <0x3950>;
					mask = <0xff7fffff>;

					checklist {
						status-offset = <0x3084>;
						active-mask = <0x80000>;
					};
				};

				wakeup-mask2 {
					mask-reg-offset = <0x3964>;
					stat-reg-offset = <0x3954>;
					mask = <0x3e1e>;
				};
			};

			eint-wakeup-masks {

				eint-wakeup-mask {
					mask-reg-offset = <0x60c>;
				};

				eint-wakeup-mask2 {
					mask-reg-offset = <0x61c>;
				};
			};
		};
	};

	exynos-cpuhp {
		compatible = "samsung,exynos-cpuhp";
		status = "okay";
	};

	exynos-ufcc {
		compatible = "samsung,exynos-ufcc";
		status = "okay";

		ucc {

			ucc-config0 {
				index = <0x00>;
				allowed = "0-7";
			};

			ucc-config1 {
				index = <0x01>;
				allowed = "4-7";
			};

			ucc-config2 {
				index = <0x02>;
			};
		};

		ufc {
			table-info = "vfreq\0lit-2nd\0lit\0emstune\0strict";

			domains {

				domain@0 {
					domain-name = "lit";
					shared-cpus = "0-3";
				};

				domain@1 {
					domain-name = "lit-2nd";
					shared-cpus = "4-7";
					allow-disable-cpus;
				};
			};

			limits {

				max-limit {
					relation = <0x01>;
					table = <0x1e8c50 0x1e8c50 0x1e8c50 0x00 0x00 0x1c2af0 0x1c2af0 0x1c2af0 0x00 0x00 0x1a94b0 0x1a94b0 0x1a94b0 0x00 0x00 0x183350 0x183350 0x183350 0x00 0x00 0x163780 0x163780 0x163780 0x00 0x00 0x13d620 0x13d620 0x13d620 0x00 0x00 0x11a788 0x11a788 0x11a788 0x00 0x00 0x101148 0x101148 0x101148 0x00 0x00 0xe7b08 0xe7b08 0xe7b08 0x00 0x00 0xc4c70 0xc4c70 0xc4c70 0x00 0x00 0x9eb10 0x9eb10 0x9eb10 0x00 0x00 0x854d0 0x854d0 0x854d0 0x00 0x00>;
				};

				min-limit {
					relation = <0x00>;
					table = <0x1e8c50 0x1e8c50 0x1e8c50 0x02 0x01 0x1c2af0 0x1c2af0 0x1c2af0 0x01 0x01 0x1a94b0 0x1a94b0 0x1a94b0 0x01 0x01 0x183350 0x183350 0x183350 0x01 0x01 0x163780 0x163780 0x163780 0x01 0x01 0x13d620 0x13d620 0x13d620 0x01 0x01 0x11a788 0x11a788 0x11a788 0x01 0x01 0x101148 0x101148 0x101148 0x01 0x01 0xe7b08 0xe7b08 0xe7b08 0x01 0x01 0xc4c70 0xc4c70 0xc4c70 0x01 0x01 0x9eb10 0x9eb10 0x9eb10 0x00 0x01 0x854d0 0x854d0 0x854d0 0x00 0x01>;
				};
			};
		};
	};

