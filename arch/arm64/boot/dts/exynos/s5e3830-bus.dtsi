		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x0a>;
		clocks = <0x03 0xa1 0x03 0x9e>;
		clock-names = "ipclk_hsi2c\0gate_hsi2c_clk";
