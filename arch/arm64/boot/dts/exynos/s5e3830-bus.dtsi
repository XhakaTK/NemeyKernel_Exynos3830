	uart@13820000 {
		compatible = "samsung,exynos-uart";
		samsung,separate-uart-clk;
		reg = <0x00 0x13820000 0x100>;
		samsung,fifo-size = <0x40>;
		interrupts = <0x00 0xe3 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x11>;
		samsung,usi-serial-v2;
		clocks = <0x03 0x23a 0x03 0x248>;
		samsung,dbg-uart-ch;
		samsung,dbg-uart-baud = <0x1c200>;
		samsung,dbg-word-len = <0x08>;
		clock-names = "gate_uart_clk0\0ipclk_uart0";
		status = "okay";
		phandle = <0xf3>;
	};

