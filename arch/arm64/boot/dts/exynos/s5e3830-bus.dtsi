		pinctrl-names = "default\0rts\0tx_dat";
		samsung,usi-serial-v2;
		samsung,usi-phandle = <0x12>;
		samsung,usi-offset = <0x00>;
		clocks = <0x03 0x9d 0x03 0xa3>;
		clock-names = "gate_uart_clk1\0ipclk_uart1";
		status = "disabled";
		phandle = <0xf4>;
	};

