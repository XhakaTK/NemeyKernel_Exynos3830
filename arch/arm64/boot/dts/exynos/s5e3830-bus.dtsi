		interrupts = <0x00 0x3f 0x04>;
		dmas = <0x0d 0x0e 0x0d 0x0f>;
		dma-names = "tx\0rx";
		swap-mode = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
