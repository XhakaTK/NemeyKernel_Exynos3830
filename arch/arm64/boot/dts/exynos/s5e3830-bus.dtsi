/* Samsung Exynos 850 (S5E3830) - aliases and low-speed / high-speed serial buses */

	aliases {
		uart0 = "/uart@13820000";
		usi0 = "/usi@10021020";
		usi1 = "/usi@10021030";
		usi2 = "/usi@10021040";
		usi3 = "/usi@10021010";
		usi4 = "/usi@10021050";
		usi5 = "/usi@11C22000";
		usi6 = "/usi@11C22010";
		hsi2c0 = "/hsi2c@138A0000";
		hsi2c1 = "/hsi2c@138B0000";
		hsi2c2 = "/hsi2c@138C0000";
		hsi2c3 = "/hsi2c@11D00000";
		hsi2c4 = "/hsi2c@11D20000";
		spi0 = "/spi@13940000";
		spi1 = "/spi@11D00000";
		spi2 = "/spi@11D20000";
		uart1 = "/uart@11D00000";
		uart2 = "/uart@11D20000";
		i2c0 = "/i2c@13830000";
		i2c1 = "/i2c@13840000";
		i2c2 = "/i2c@13850000";
		i2c3 = "/i2c@13860000";
		i2c4 = "/i2c@13870000";
		i2c5 = "/i2c@13880000";
		i2c6 = "/i2c@13890000";
		mshc0 = "/dwmmc0@12100000";
		mshc2 = "/dwmmc2@13500000";
		panel0 = "/panel_0";
		panel_drv0 = "/panel_drv@0";
		dpp0 = "/dpp@0x130B4000";
		dpp1 = "/dpp@0x130B2000";
		dpp2 = "/dpp@0x130B3000";
		dpp3 = "/dpp@0x130B1000";
		dsim0 = "/dsim@0x13070000";
		decon0 = "/decon_f@0x13060000";
		smfc0 = "/smfc@12C90000";
		scaler0 = "/scaler@12CB0000";
		iommu-group-module0 = "/is_iommu_group_module";
		iommu-group0 = "/is_iommu_group0";
		pinctrl0 = "/pinctrl@11850000";
		pinctrl1 = "/pinctrl@11c30000";
		pinctrl2 = "/pinctrl@14a60000";
		pinctrl3 = "/pinctrl@13430000";
		pinctrl4 = "/pinctrl@12070000";
		pinctrl5 = "/pinctrl@139b0000";
		contexthub0 = "/contexthub";
	};

	usi@10021020 {
		compatible = "samsung,exynos-usi-v2";
		reg = <0x00 0x10021020 0x04>;
		status = "disabled";
		phandle = <0xe4>;
	};

	usi@10021030 {
		compatible = "samsung,exynos-usi-v2";
		reg = <0x00 0x10021030 0x04>;
		status = "disabled";
		phandle = <0xe5>;
	};

