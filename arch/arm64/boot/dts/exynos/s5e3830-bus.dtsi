		dmas = <0x0d 0x0c 0x0d 0x0d>;
		dma-names = "tx\0rx";
		swap-mode = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x03 0x9d 0x03 0xa0>;
