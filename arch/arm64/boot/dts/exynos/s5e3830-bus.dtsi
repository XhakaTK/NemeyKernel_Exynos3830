	spi@13940000 {
		compatible = "samsung,exynos-spi";
		reg = <0x00 0x13940000 0x100>;
		samsung,spi-fifosize = <0x40>;
		interrupts = <0x00 0xdd 0x04>;
		dmas = <0x0d 0x05 0x0d 0x04>;
		dma-names = "tx\0rx";
		swap-mode = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		clocks = <0x03 0x239 0x03 0x23d>;
		clock-names = "gate_spi_clk\0ipclk_spi";
		pinctrl-names = "default";
		pinctrl-0 = <0x0e>;
		status = "disabled";
		phandle = <0xf0>;
	};

