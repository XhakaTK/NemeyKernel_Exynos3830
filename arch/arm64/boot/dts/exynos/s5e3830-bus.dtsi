		phandle = <0x12>;
	};

	hsi2c@138A0000 {
		compatible = "samsung,exynos5-hsi2c";
		samsung,check-transdone-int;
		default-clk = <0xbebc200>;
		reg = <0x00 0x138a0000 0x1000>;
		interrupts = <0x00 0xc1 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x02>;
		clocks = <0x03 0x23e 0x03 0x22c>;
		clock-names = "ipclk_hsi2c\0gate_hsi2c_clk";
		samsung,scl-clk-stretching;
		samsung,usi-i2c-v2;
		gpio_scl = <0x04 0x01 0x01>;
		gpio_sda = <0x04 0x00 0x01>;
		status = "disabled";
		phandle = <0xeb>;
	};

	hsi2c@138B0000 {
		compatible = "samsung,exynos5-hsi2c";
