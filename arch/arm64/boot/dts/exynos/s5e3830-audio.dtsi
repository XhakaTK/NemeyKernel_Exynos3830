	abox-gic@14af0000 {
		compatible = "samsung,abox-gic";
		reg = <0x00 0x14af1000 0x1000 0x00 0x14af2000 0x1004>;
		reg-names = "gicd\0gicc";
		interrupts = <0x00 0x40 0x04>;
		phandle = <0x7b>;
	};

	abox@14a50000 {
		compatible = "samsung,abox";
		reg = <0x00 0x14a50000 0x10000 0x00 0x14a10000 0x10000 0x00 0x14b00000 0x2d000 0x00 0x14ae0000 0x10000>;
		reg-names = "sfr\0sysreg\0sram\0timer";
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;
		iommus = <0x78>;
		memory-region = <0x79>;
		power-domains = <0x33>;
		samsung,iommu-group = <0x7a>;
		clocks = <0x03 0x43 0x03 0x53 0x03 0x47 0x03 0x4e>;
		clock-names = "pll\0audif\0bus\0cnt";
		#sound-dai-cells = <0x01>;
		sound-name-prefix = "ABOX";
		samsung,quirks = "try to asrc off";
		samsung,ipc-tx-area = <0x01 0x850000 0x18000>;
		samsung,ipc-rx-area = <0x01 0x868000 0x18000>;
		samsung,shm-area = <0x01 0x8bc000 0x4000>;
		samsung,handshake-area = <0x00 0x23800 0x20>;
		samsung,abox-bootargs = "slog=1 vss=1 kernel_ver=t";
		samsung,abox-bootargs-offset = <0x23e00>;
		samsung,abox-gic = <0x7b>;
		samsung,uaif-max-div = <0x200>;
		samsung,pm-qos-int = <0x00 0x00 0x00 0x00 0x00>;
		samsung,pm-qos-aud = <0xfc328 0xc3500 0x7e388 0x543a8 0x00>;
		samsung,pm-qos-stable-min = <0x543a8>;
		phandle = <0x11a>;

		abox-core@14a55000 {
			compatible = "samsung,abox-core";
			reg = <0x00 0x14a55000 0x80>;
			reg-names = "gpr";
			samsung,id = <0x00>;
			samsung,type = "CA32";
			samsung,pmu_power = <0x2d80 0x01>;
			samsung,pmu_enable = <0x2da0 0x01>;
			samsung,pmu_standby = <0x2da4 0x11>;
			phandle = <0x11b>;

			abox-firmware-sram0 {
				samsung,name = "calliope_sram.bin";
				samsung,area = <0x00>;
				samsung,offset = <0x00>;
				phandle = <0x11c>;
			};

			abox-firmware-dram0 {
				samsung,name = "calliope_dram.bin";
				samsung,area = <0x01>;
				samsung,offset = <0x00>;
				phandle = <0x11d>;
			};
		};

		abox-core@14a55080 {
			compatible = "samsung,abox-core";
			reg = <0x00 0x14a55080 0x80 0x00 0x14a55100 0x04>;
			reg-names = "gpr\0status";
