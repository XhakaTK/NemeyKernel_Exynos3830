		};

		bts_aud {
			reg = <0x00 0x12400000 0x100>;
			status = "okay";
			bts-type = <0x01>;

			default {
				stat_on = <0x01>;
				bypass = <0x00>;
				arqos = <0x0e>;
				awqos = <0x0e>;
				rmo = <0x04>;
				wmo = <0x04>;
				qurgent_on = <0x00>;
				blocking_on = <0x01>;
				qmax0_limit_r = <0x04>;
				qmax0_limit_w = <0x04>;
			};
		};

		bts_corex {
			reg = <0x00 0x12430000 0x100>;
