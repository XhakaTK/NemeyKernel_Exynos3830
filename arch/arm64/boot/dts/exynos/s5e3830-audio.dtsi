/* Samsung Exynos 850 (S5E3830) - Broadcom BT stack and ABOX audio DSP */

	exynos-bts {
		compatible = "samsung,exynos-bts";
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;
		list-scen = "default\0g3d_performance\0mfc_performance\0camera_default";
		int_request_disable = <0x01>;

		bts_nrt_mem0 {
			reg = <0x00 0x12512000 0x100>;
			status = "okay";
			bts-type = <0x05>;

			default {
				stat_on = <0x00>;
			};
		};

		bts_nrt_mem1 {
			reg = <0x00 0x12522000 0x100>;
			status = "okay";
			bts-type = <0x05>;

			default {
				stat_on = <0x00>;
			};
		};

		bts_rt_mem0 {
			reg = <0x00 0x124f2000 0x100>;
			status = "okay";
			bts-type = <0x05>;

			default {
				stat_on = <0x00>;
